@startuml system_data_flow
skinparam monochrome false
skinparam roundcorner 10
skinparam defaultFontName SansSerif

actor "Operator" as Pilot
participant "Controller\n(Teleop)" as Teleop
participant "GN10 Mainboard\n(STM32G474 + W5500)" as MainBoard
participant "Jetson\n(ROS 2)" as Jetson
collections "CAN Devices\n(CAN1 / FDCAN2 / FDCAN3)" as Actuators

Pilot -> Teleop : Stick / D-Pad / Switch input
Teleop -> MainBoard : teleop_t (UDP: 10410)

group Mainboard Control Pipeline
    MainBoard -> MainBoard : 1. Parse teleop_t & mode switch\n(Manual / Auto)
    MainBoard -> MainBoard : 2. Update RobotStateMachine\n(TargetId & NavigationCommand)
    Jetson -> MainBoard : operation_t (UDP: 39244)
    MainBoard -> MainBoard : 3. Arbitrate control authority\n(ControlArbitrator)
    MainBoard -> Actuators : 4. Send CAN / FDCAN commands
end

Actuators --> MainBoard : CAN / FDCAN feedback
MainBoard -> Jetson : feedback_t + command_t (UDP: 39244, 20 ms)
@enduml
