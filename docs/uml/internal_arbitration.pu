@startuml internal_arbitration
skinparam componentStyle uml2

package "Ethernet Input (W5500)" {
    [Teleop (UDP: 10410)] as InTeleop
    [Operation (UDP: 39244)] as InOperation
}

package "Mainboard Core" {
    component "RobotStateMachine" as FSM
    component "ControlArbitrator" as Arbitrator
}

package "CAN Bus Output" {
    [3-Wheel Omni (FDCAN3 / C620)] as Wheel
    [Belt Launcher (FDCAN3 / VESC)] as Belt
    [Arm & Loader (FDCAN3 / C610, CAN1 / DC)] as Arm
    [Solenoid (CAN1)] as Air
    [Power & LED (FDCAN2)] as PowerLED
}

InTeleop --> FSM : Mode toggle, TargetId, Cancel
InOperation --> FSM : NavigationStatus sync\n(200 ms timeout)

FSM --> [Feedback & Command (UDP: 39244)] : feedback_t (command_t)

InTeleop --> Arbitrator : Manual commands
InOperation --> Arbitrator : Autonomous commands\n(vel, belt_launcher_speed)
FSM --> Arbitrator : Current NavigationStatus

Arbitrator --> Wheel : vx, vy, vyaw
Arbitrator --> Belt : Target velocity & fire trigger (R1)
Arbitrator --> Arm : Height, width, hold, reload
Arbitrator --> Air : Fire trigger (L1)
InTeleop --> PowerLED : Remote EMS (right_toggle_sw)
@enduml
